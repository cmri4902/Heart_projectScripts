export REPO=/home/ypan/heart_liver/model_train/heart-molecular-pretraining
export PY="$HOME/.conda/envs/heart_gpu/bin/python"
export ADAPTER="$REPO/model/pretrain/lipid_library/lnpdb_to_heart.py"

export GENERAL_DICT=/project/yli4/ypan/UniMolReference/ligand_data/ligands/dict.txt
export LNPDB_ROOT=/project/yli4/ypan/lipid_library/lnpdb_heart
export LNPDB_PREPARED="$LNPDB_ROOT/prepared/lnpdb_unique_prepared.csv"
export LNPDB_FULL_OUT="$LNPDB_ROOT/lmdb_full"
export NUM_SHARDS=16

#### check LNPDB code location

ls -lh "$ADAPTER"
ls -lh "$REPO/model/pretrain/scripts/lipid_library/lnpdb_build.sbatch"
ls -lh "$LNPDB_PREPARED"

#### library generation 

mkdir -p "$LNPDB_ROOT/logs"

sbatch --export=ALL \
  --array=0-15%4 \
  --output="$LNPDB_ROOT/logs/HEART_LNPDB_%A_%a.out" \
  --error="$LNPDB_ROOT/logs/HEART_LNPDB_%A_%a.err" \
  "$REPO/model/pretrain/scripts/lipid_library/lnpdb_build.sbatch"

### validation 

"$PY" "$ADAPTER" finalize \
  --out "$LNPDB_FULL_OUT" \
  --prepared "$LNPDB_PREPARED" \
  --num-shards 16

"$PY" "$ADAPTER" verify \
  --repo "$REPO" \
  --dict "$GENERAL_DICT" \
  --out "$LNPDB_FULL_OUT" \
  --check-all


